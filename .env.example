# ═══════════════════════════════════════════════════════════════════════
# MOZONA TPV — Variables de entorno (EJEMPLO - sin secretos reales)
# ═══════════════════════════════════════════════════════════════════════
# Copiar este archivo a .env.production y rellenar valores reales.
# NUNCA commitear .env.production al repositorio.
#
# Las variables VITE_* se inyectan al bundle en npm run build.
# Las variables SIN prefijo VITE_ NO se exponen al frontend.
# ═══════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────
# SUPABASE (obligatorio)
# ─────────────────────────────────────────────────────────────────────
# URL pública del proyecto Supabase
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co

# ANON KEY (PUBLICA - se inyecta al bundle)
# Esta key está limitada por RLS, así que es seguro exponerla.
# Formato nuevo: sb_publishable_xxx o legacy: eyJ...
VITE_SUPABASE_ANON_KEY=sb_publishable_TU_ANON_KEY

# SERVICE ROLE KEY (PRIVADA - NUNCA debe ir al bundle)
# Esta key bypasea RLS. SOLO se usa en backend/Edge Functions.
# Si la pones aquí con VITE_, se filtrará al bundle.
# Recomendación: usar solo en Supabase Edge Functions Secrets.
#
# ⛔ NO definir la service role key con prefijo VITE_. Se inyectaría al bundle
#    y comprometería TODO el proyecto (bypassa RLS). Úsala SOLO sin prefijo VITE_
#    en el backend / secrets de Edge Functions:
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY   # sin VITE_

# ─────────────────────────────────────────────────────────────────────
# ADMIN
# ─────────────────────────────────────────────────────────────────────
# Email del superadmin (puede ver /admin)
VITE_SUPERADMIN_EMAIL=admin@tudominio.com

# ─────────────────────────────────────────────────────────────────────
# TELEGRAM (bot de notificaciones)
# ─────────────────────────────────────────────────────────────────────
# Token del bot de Telegram
# Crear via @BotFather en Telegram
#
# ⛔ El token del bot NO debe llevar prefijo VITE_ (se filtraría al bundle y
#    cualquiera podría enviar mensajes como el bot). Configúralo como secret
#    del backend / Edge Function, sin prefijo VITE_:
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...   # sin VITE_

# Chat ID donde se envían las notificaciones de prueba
# Obtener ejecutando: curl https://api.telegram.org/bot${TOKEN}/getUpdates
VITE_TELEGRAM_CHAT_ID=123456789

# ─────────────────────────────────────────────────────────────────────
# BUILD INFO
# ─────────────────────────────────────────────────────────────────────
# Hash del build actual (auto-set durante deploy)
VITE_BUILD_HASH=v4.0.7-local

# ─────────────────────────────────────────────────────────────────────
# ENTORNOS SOPORTADOS
# ─────────────────────────────────────────────────────────────────────
# GitHub Pages:  lee .env.production durante npm run build
# Vercel:        lee process.env.VAR_* durante build (caído desde 2026-09-18)
# Supabase:      Edge Functions leen sus propios Secrets
# Local dev:     lee .env.local durante npm run dev
#
# ⚠ VITE_SUPABASE_SERVICE_ROLE_KEY NUNCA debe llegar al bundle JS.
#   Si ves que aparece en /assets/*.js, hay un problema de seguridad.
#
# Recomendación arquitectónica:
#   - Mover SERVICE_ROLE_KEY a Supabase Edge Function Secrets
#   - El frontend llama a la Edge Function (que tiene la key segura)
#   - La Edge Function hace las operaciones privilegiadas
# ═══════════════════════════════════════════════════════════════════════
